{
  "name": "manga-p0-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Internal P0 workbench for batch comic post-production with Miguo MCP.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.mjs",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1",
    "check": "node scripts/check-syntax.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "admin:create": "node --disable-warning=ExperimentalWarning scripts/create-admin.mjs",
    "seed:demo": "node --disable-warning=ExperimentalWarning scripts/seed-frontend-demo.mjs",
    "recover:classic": "node --disable-warning=ExperimentalWarning scripts/recover-classic-task.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.6.2",
    "sharp": "^0.34.4"
  }
}
