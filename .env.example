# Server
HOST=127.0.0.1
PORT=4317
DATA_ROOT=./data
DEFAULT_PROVIDER=mock
WORKER_CONCURRENCY=2
MAX_UPLOAD_FILES=50
MAX_UPLOAD_BYTES=20971520
P0_MAX_POINTS_PER_BATCH=2880

# Application accounts. Keep true on an internet-facing deployment.
AUTH_REQUIRED=false
ALLOW_PUBLIC_REGISTRATION=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_PATH=/
AUTH_TRUST_PROXY=false
AUTH_SESSION_DAYS=7
AUTH_MAX_USERS=100

# Miguo. Keep these values on the server only. Never use VITE_ or expose them.
MIGUO_ACCOUNT_ID=
MIGUO_API_TOKEN=
MIGUO_MCP_URL=https://factory.miguocomics.com/api/mcp/v1
MIGUO_CHANNEL=slow
MIGUO_TIMEOUT_MS=900000
MIGUO_OUTPUT_HOSTS=factory.miguocomics.com,oss.miguocomics.com

# Miguo 3.0 / StoryArk. Credentials remain server-side; endpoint/tool routing is fixed in code.
MIGUO_STORYARK_ACCOUNT_ID=
MIGUO_STORYARK_API_TOKEN=
MIGUO_STORYARK_MCP_URL=https://storyark.miguocomics.com/api/mcp/v1
MIGUO_STORYARK_TIMEOUT_MS=360000
MIGUO_STORYARK_OUTPUT_HOSTS=storyark.miguocomics.com,static-02.miguocomics.com
STORYARK_MAX_RESULTS_PER_BATCH=20

# Server-managed renderer for the customer-facing storyboard workflow.
# The browser never chooses or displays the provider/model.
STUDIO_STORYBOARD_RENDER_PROVIDER=nano_banana_2
STUDIO_STORYBOARD_PROJECT_ID=

# Optional safety guard. Real provider calls require both values to be true.
ALLOW_REAL_PROVIDER=false
P0_INTERNAL_USE_ACK=false
ALLOW_STORYARK_GENERATION=false
STORYARK_INTERNAL_USE_ACK=false

# Studio storyboard-understanding Agent. Keep the relay key server-side only.
STUDIO_MAIN_MODEL_BASE_URL=https://ai-hub.miguocomics.co/v1
STUDIO_MAIN_MODEL_API_KEY=
STUDIO_MAIN_MODEL_BATCH_MODEL=gpt-5.6-luna
STUDIO_MAIN_MODEL_INTERACTIVE_MODEL=gpt-5.6-terra
STUDIO_MAIN_MODEL_ENABLED=false
STUDIO_MAIN_MODEL_TIMEOUT_MS=600000
STUDIO_MAIN_MODEL_MAX_OUTPUT_TOKENS=16000
STUDIO_MAIN_MODEL_MAX_BATCH_PANELS=20

# Nano Banana 2 storyboard render proposal. It may reuse the main-model relay,
# but paid image generation remains protected by its own two explicit gates.
STUDIO_IMAGE_MODEL_BASE_URL=https://ai-hub.miguocomics.co/v1
STUDIO_IMAGE_MODEL_API_KEY=
STUDIO_IMAGE_MODEL_MODEL=gemini-3.1-flash-image
STUDIO_IMAGE_MODEL_ENABLED=false
STUDIO_IMAGE_MODEL_TIMEOUT_MS=600000
ALLOW_STUDIO_IMAGE_GENERATION=false
STUDIO_IMAGE_INTERNAL_USE_ACK=false

# Controlled failure injection for validation. Values: none | network_once | interrupt_once
P0_FAULT_MODE=none
